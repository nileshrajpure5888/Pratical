# Practical: Customer Segmentation using K-Means Clustering and PCA

import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

from sklearn.cluster import KMeans
from sklearn.decomposition import PCA

# --------------------------------------------------
# 1. Import dataset
# --------------------------------------------------
df = pd.read_csv(
    "C:/Users/Nilesh Rajpure/Downloads/sales_data_sample.csv",
    encoding="cp1252"
)

print("First 5 rows:")
display(df.head())

print("\nDataset Shape:")
print(df.shape)

print("\nSummary Statistics:")
display(df.describe())

print("\nDataset Information:")
df.info()

print("\nMissing Values:")
print(df.isnull().sum())

print("\nData Types:")
print(df.dtypes)

# --------------------------------------------------
# 2. Data preprocessing
# --------------------------------------------------
df_drop = [
    'ADDRESSLINE1',
    'ADDRESSLINE2',
    'STATUS',
    'POSTALCODE',
    'CITY',
    'TERRITORY'
]

df = df.drop(columns=df_drop, errors='ignore')

print("\nUnique Countries:")
if 'COUNTRY' in df.columns:
    print(df['COUNTRY'].unique())

print("\nUnique Product Lines:")
if 'PRODUCTLINE' in df.columns:
    print(df['PRODUCTLINE'].unique())

print("\nUnique Deal Sizes:")
if 'DEALSIZE' in df.columns:
    print(df['DEALSIZE'].unique())

# One-hot encode PRODUCTLINE and DEALSIZE
productline = pd.get_dummies(df['PRODUCTLINE'], dtype=int)
dealsize = pd.get_dummies(df['DEALSIZE'], dtype=int)

df = pd.concat([df, productline, dealsize], axis=1)

# Remove original categorical columns and other text identifiers
df = df.drop(
    columns=[
        'COUNTRY', 'PRODUCTLINE', 'DEALSIZE', 'ORDERDATE',
        'CUSTOMERNAME', 'PHONE', 'STATE',
        'CONTACTLASTNAME', 'CONTACTFIRSTNAME'
    ],
    errors='ignore'
)

# Convert PRODUCTCODE to numeric category codes
if 'PRODUCTCODE' in df.columns:
    df['PRODUCTCODE'] = pd.Categorical(df['PRODUCTCODE']).codes

# Convert remaining columns to numeric and handle missing values
df = df.apply(pd.to_numeric, errors='coerce')
df = df.fillna(0)

print("\nDatatypes after preprocessing:")
print(df.dtypes)

print("\nFinal shape:")
print(df.shape)

# --------------------------------------------------
# 3. Prepare data for K-Means
# --------------------------------------------------
X_train = df.values

# --------------------------------------------------
# 4. Elbow Method
# --------------------------------------------------
distortions = []
K = range(1, 10)

for k in K:
    kmeanModel = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )
    kmeanModel.fit(X_train)
    distortions.append(kmeanModel.inertia_)

plt.figure(figsize=(10, 6))
plt.plot(K, distortions, 'bx-')
plt.xlabel('Number of clusters (k)')
plt.ylabel('Distortion / Inertia')
plt.title('Elbow Method Showing the Optimal k')
plt.grid(True)
plt.show()

# --------------------------------------------------
# 5. K-Means with 3 clusters
# --------------------------------------------------
model = KMeans(
    n_clusters=3,
    random_state=2,
    n_init=10
)

model.fit(X_train)
predictions = model.predict(X_train)

unique, counts = np.unique(predictions, return_counts=True)
counts_df = pd.DataFrame({
    'Cluster': unique,
    'Number of observations': counts
})

print("\nNumber of observations in each cluster:")
display(counts_df)

# --------------------------------------------------
# 6. PCA for 2D visualization
# --------------------------------------------------
pca = PCA(n_components=2)
reduced_X = pd.DataFrame(
    pca.fit_transform(X_train),
    columns=['PCA1', 'PCA2']
)

# --------------------------------------------------
# 7. Plot PCA data
# --------------------------------------------------
plt.figure(figsize=(10, 7))
plt.scatter(reduced_X['PCA1'], reduced_X['PCA2'])
plt.xlabel('PCA1')
plt.ylabel('PCA2')
plt.title('PCA Visualization')
plt.show()

# --------------------------------------------------
# 8. Cluster centroids
# --------------------------------------------------
centers = model.cluster_centers_

print("\nCluster centroids:")
print(centers)

reduced_centers = pca.transform(centers)

print("\nPCA coordinates of centroids:")
print(reduced_centers)

# --------------------------------------------------
# 9. Plot data points and centroids
# --------------------------------------------------
plt.figure(figsize=(10, 7))
plt.scatter(reduced_X['PCA1'], reduced_X['PCA2'], alpha=0.5)
plt.scatter(
    reduced_centers[:, 0],
    reduced_centers[:, 1],
    color='black',
    marker='x',
    s=250,
    label='Centroids'
)
plt.xlabel('PCA1')
plt.ylabel('PCA2')
plt.title('Data Points and Cluster Centroids')
plt.legend()
plt.show()

# --------------------------------------------------
# 10. Add cluster labels and visualize clusters
# --------------------------------------------------
reduced_X['Clusters'] = predictions

print("\nClustered data:")
display(reduced_X.head())

plt.figure(figsize=(10, 7))

for cluster in sorted(reduced_X['Clusters'].unique()):
    cluster_data = reduced_X[reduced_X['Clusters'] == cluster]
    plt.scatter(
        cluster_data['PCA1'],
        cluster_data['PCA2'],
        label=f'Cluster {cluster}',
        alpha=0.6
    )

plt.scatter(
    reduced_centers[:, 0],
    reduced_centers[:, 1],
    color='black',
    marker='x',
    s=250,
    label='Centroids'
)

plt.xlabel('PCA1')
plt.ylabel('PCA2')
plt.title('K-Means Clustering with PCA')
plt.legend()
plt.show()

print("\nPractical completed successfully.")
