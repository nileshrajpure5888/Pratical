
# Import Libraries
import pandas as pd
import numpy as np

from sklearn.svm import SVC
from sklearn.neighbors import KNeighborsClassifier
from sklearn import metrics
from sklearn.preprocessing import scale
from sklearn.model_selection import train_test_split

# Import Dataset
df = pd.read_csv("C:/Users/Nilesh Rajpure/Downloads/emails.csv")

# Display Dataset
display(df)

# First Five Rows
display(df.head())

# Dataset Size
print("Dataset Shape:", df.shape)

# Data Types
print(df.dtypes)

# Column Names
print(df.columns)

# Summary Statistics
display(df.describe())

# Check Null Values
s = df.isnull().sum()
print("Null Values:")
print(s[s > 0])

print("Check Missing Values:")
print(df.isnull().any())

# Drop Missing Values
df.dropna(inplace=True)

# Drop Email No. Column
df.drop(['Email No.'], axis=1, inplace=True)

# Display First Five Rows
display(df.head())

# Check Unique Prediction Values
print("Unique Prediction Values:")
print(df['Prediction'].unique())

# Replace Prediction Values
df['Prediction'] = df['Prediction'].replace({
    0: 'Not spam',
    1: 'Spam'
})

# Display Dataset
display(df)

# Separate Features and Target
X = df.drop(columns='Prediction', axis=1)
Y = df['Prediction']

# Scale Features
X = scale(X)

# Split Training and Testing Data
X_train, X_test, y_train, y_test = train_test_split(
    X,
    Y,
    test_size=0.3,
    random_state=42
)

# -------------------------------
# KNN CLASSIFIER
# -------------------------------

knn = KNeighborsClassifier(n_neighbors=7)

# Train Model
knn.fit(X_train, y_train)

# Prediction
y_pred = knn.predict(X_test)

print("\nKNN Predictions:")
print(y_pred)

# KNN Accuracy
M = metrics.accuracy_score(y_test, y_pred)

print("\nKNN Accuracy:", M)

# KNN Confusion Matrix
C = metrics.confusion_matrix(y_test, y_pred)

print("\nKNN Confusion Matrix:")
print(C)

# -------------------------------
# SVM CLASSIFIER
# -------------------------------

model = SVC(C=1)

# Train Model
model.fit(X_train, y_train)

# Prediction
y_pred = model.predict(X_test)

print("\nSVM Predictions:")
print(y_pred)

# SVM Confusion Matrix
print("\nSVM Confusion Matrix:")
print(metrics.confusion_matrix(
    y_true=y_test,
    y_pred=y_pred
))

# SVM Accuracy
print("\nSVM Accuracy:",
      metrics.accuracy_score(y_test, y_pred))
